  "cards": [
    {
      "dot": "cyan",
      "title": "入口与会话",
      "items": [
        "Widget → AgentBot；human 只写 Message Store，Seat Takeover 后才切 mode",
        "thread 惰性创建、有界水合；pending interrupt 固定 thread，ThreadReaper 在完成边界轮换/清理"
      ]
    },
    {
      "dot": "emerald",
      "title": "编排与风险分层",
      "items": [
        "Guard ∥ Router → Policy 派生 Read / Mutation / HighRisk / Complaint / Fallback",
        "Mutation 用 Form；HighRisk 预检→审批→重校验；Complaint 不自动转人工，Fallback 独立兜底"
      ]
    },
    {
      "dot": "rose",
      "title": "状态、审批与模型",
      "items": [
        "conversation_mode 外置；messages / approvals / threads / checkpoints 分职责存储",
        "Seat Takeover 切 human；Approval 走独立旁路不切 mode；Router/Agent 调 ARK"
      ]
    }
  ]
